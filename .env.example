# Copy to .env and fill as needed. Never commit real secrets.

# Vision / LLM critic (OpenRouter)
OPENROUTER_API_KEY=
GAUNTLET_CRITIC_MODEL=openai/gpt-4o-mini
GAUNTLET_VISION_MODEL=openai/gpt-4o

# Agent environment hint: cursor | claude-code | codex | generic
GAUNTLET_AGENT_ENV=

# Local web shell (optional). If set, send: Authorization: Bearer <token>
GAUNTLET_WEB_TOKEN=

# Stripe — Pro run budgets (optional for local testing)
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO=price_gauntlet_pro_placeholder
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Web
PORT=8787
GAUNTLET_CWD=
