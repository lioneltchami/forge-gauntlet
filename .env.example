# Copy to .env and fill as needed. Never commit real secrets.

# Vision / LLM critic (OpenRouter)
OPENROUTER_API_KEY=
GAUNTLET_CRITIC_MODEL=openai/gpt-4o-mini
GAUNTLET_VISION_MODEL=openai/gpt-4o

# Agent environment hint: cursor | claude-code | codex | generic
GAUNTLET_AGENT_ENV=

# Local web shell auth (fail-closed). Send: Authorization: Bearer <token>
GAUNTLET_WEB_TOKEN=
# Loopback-only open mode for local UI without a token (do not use on public hosts)
GAUNTLET_WEB_ALLOW_ANON=
# Comma-separated allowed CORS origins (defaults to http://127.0.0.1:$PORT and localhost)
GAUNTLET_WEB_ORIGINS=

# Stripe — Pro run budgets (optional for local testing)
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO=price_gauntlet_pro_placeholder
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Web — binds loopback by default
HOST=127.0.0.1
PORT=8787
GAUNTLET_CWD=
